generator client {
    provider = "prisma-client"
    output   = "../src/generated"
}

datasource db {
    provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  privyId          String    @unique
  name             String?
  avatarUrl        String?
  investmentAmount Float     @default(0)
  refreshToken     String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
}