generator client {
    provider = "prisma-client"
    output   = "../src/generated"
}

datasource db {
    provider = "postgresql"
}

enum Chain {
    SOLANA
}

enum StockType {
    USStock
    PreIPO
    IndexFunds
}

enum TradeType {
    BUY
    SELL
}

enum TransactionType {
    DEPOSIT
    WITHDRAW
    TRANSFER
    SWAP
    PROGRAM
}

enum TransactionStatus {
    PENDING
    CONFIRMED
    FAILED
}

model User {
    id                  String                @id @default(cuid())
    userId              String                @unique
    walletId            String                @unique
    email               String                @unique
    name                String
    walletAddress       String                @unique
    googleSubjectId     String                @unique
    investments         Investment[]
    trades              Trades[]
    recurringBuyRequest RecurringBuyRequest[]
    createdAt           DateTime              @default(now())
    updatedAt           DateTime              @updatedAt

    @@index([userId])
    @@index([walletId])
}

model Stocks {
    tokenAddress    String    @id
    price           String
    name            String
    decimals        Int       @default(8)
    symbol          String
    imageUrl        String
    marketOpenPrice String    @default("0")
    stockType       StockType @default(USStock)
}

model Investment {
    id                String @id @default(cuid())
    userId            String
    stockSymbol       String
    stockAmount       Float
    stockAddress      String
    investmesntAmount Float  @default(0)
    user              User   @relation(fields: [userId], references: [userId])
}

model Trades {
    id               String    @id @default(cuid())
    userId           String
    stockAddress     String
    stockPrice       Float
    investmentAmount Float
    tradeType        TradeType
    createdAt        DateTime  @default(now()) @db.Timestamp(3)
    user             User      @relation(fields: [userId], references: [userId])

    @@index([userId])
    @@index([userId, createdAt])
    @@index([stockAddress])
}

model LoginDetails {
    id               String   @id @default(cuid())
    email            String   @unique
    interestedStocks String[]
    amountToPutIn    Float
    positionHold     String
    expectToHold     String
}

model RecurringBuyRequest {
    id           String  @id @default(cuid())
    stockAddress String
    userId       String
    usdcAmount   String?
    stockAmount  String?
    buyDate      String
    user         User    @relation(fields: [userId], references: [userId])
}
